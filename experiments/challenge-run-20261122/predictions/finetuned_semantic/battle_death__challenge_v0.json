  "q_B": {
    "battle_death__challenge_v0__q0491": "SELECT COUNT(*) AS \"_col_0\" FROM \"vessel\" AS \"ship\" WHERE \"ship\".\"disposition_of_vessel\" = 'Captured'",
    "battle_death__challenge_v0__q0492": "SELECT \"ship\".\"label\" AS \"name\", \"ship\".\"tonnage\" AS \"tonnage\" FROM \"vessel\" AS \"ship\" ORDER BY \"name\" DESC",
    "battle_death__challenge_v0__q0493": "SELECT \"battle\".\"label\" AS \"name\", \"battle\".\"event_day\" AS \"date\" FROM \"combat_event\" AS \"battle\"",
    "battle_death__challenge_v0__q0494": "SELECT MAX(\"death\".\"killed\") AS \"_col_0\", MIN(\"death\".\"killed\") AS \"_col_1\" FROM \"casualty\" AS \"death\"",
    "battle_death__challenge_v0__q0495": "SELECT AVG(\"death\".\"injured\") AS \"_col_0\" FROM \"casualty\" AS \"death\"",
    "battle_death__challenge_v0__q0496": "SELECT \"t1\".\"killed\" AS \"killed\", \"t1\".\"injured\" AS \"injured\" FROM \"casualty\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"caused_by_vessel_key\" = \"t2\".\"record_key\" WHERE \"t2\".\"tonnage\" = 't'",
    "battle_death__challenge_v0__q0497": "SELECT \"battle\".\"label\" AS \"name\", \"battle\".\"outcome\" AS \"result\" FROM \"combat_event\" AS \"battle\" WHERE \"battle\".\"bulgarian_commander\" <> 'Boril'",
    "battle_death__challenge_v0__q0498": "SELECT DISTINCT \"t1\".\"record_key\" AS \"id\", \"t1\".\"label\" AS \"name\" FROM \"combat_event\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"record_key\" = \"t2\".\"lost_in_combat\" WHERE \"t2\".\"vessel_category\" = 'Brig'",
    "battle_death__challenge_v0__q0499": "SELECT \"t1\".\"record_key\" AS \"id\", \"t1\".\"label\" AS \"name\" FROM \"combat_event\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"record_key\" = \"t2\".\"lost_in_combat\" JOIN \"casualty\" AS \"t3\" ON \"t2\".\"record_key\" = \"t3\".\"caused_by_vessel_key\" GROUP BY \"t1\".\"record_key\" HAVING SUM(\"t3\".\"killed\") > 10",
    "battle_death__challenge_v0__q0500": "SELECT \"t2\".\"record_key\" AS \"id\", \"t2\".\"label\" AS \"name\" FROM \"casualty\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"caused_by_vessel_key\" = \"t2\".\"record_key\" GROUP BY \"t2\".\"record_key\" ORDER BY COUNT(*) DESC LIMIT 1",
    "battle_death__challenge_v0__q0501": "SELECT \"battle\".\"label\" AS \"name\" FROM \"combat_event\" AS \"battle\" WHERE \"battle\".\"bulgarian_commander\" = 'Kaloyan' AND \"battle\".\"latin_commander\" = 'Baldwin I'",
    "battle_death__challenge_v0__q0502": "SELECT COUNT(DISTINCT \"battle\".\"outcome\") AS \"_col_0\" FROM \"combat_event\" AS \"battle\"",
    "battle_death__challenge_v0__q0503": "SELECT COUNT(*) AS \"_col_0\" FROM \"combat_event\" AS \"battle\" WHERE NOT \"battle\".\"record_key\" IN (SELECT \"ship\".\"lost_in_combat\" AS \"lost_in_battle\" FROM \"vessel\" AS \"ship\" WHERE \"ship\".\"tonnage\" = '225')",
    "battle_death__challenge_v0__q0504": "SELECT \"t1\".\"label\" AS \"name\", \"t1\".\"event_day\" AS \"date\" FROM \"combat_event\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"record_key\" = \"t2\".\"lost_in_combat\" WHERE \"t2\".\"label\" = 'Lettice' INTERSECT SELECT \"t1\".\"label\" AS \"name\", \"t1\".\"event_day\" AS \"date\" FROM \"combat_event\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"record_key\" = \"t2\".\"lost_in_combat\" WHERE \"t2\".\"label\" = 'HMS Atalanta'",
    "battle_death__challenge_v0__q0505": "SELECT \"battle\".\"label\" AS \"name\", \"battle\".\"outcome\" AS \"result\", \"battle\".\"bulgarian_commander\" AS \"bulgarian_commander\" FROM \"combat_event\" AS \"battle\" EXCEPT SELECT \"t1\".\"label\" AS \"name\", \"t1\".\"outcome\" AS \"result\", \"t1\".\"bulgarian_commander\" AS \"bulgarian_commander\" FROM \"combat_event\" AS \"t1\" JOIN \"vessel\" AS \"t2\" ON \"t1\".\"record_key\" = \"t2\".\"lost_in_combat\" WHERE \"t2\".\"site\" = 'English Channel'",
    "battle_death__challenge_v0__q0506": "SELECT \"death\".\"annotation\" AS \"note\" FROM \"casualty\" AS \"death\" WHERE \"death\".\"annotation\" LIKE '%East%'"
  },
