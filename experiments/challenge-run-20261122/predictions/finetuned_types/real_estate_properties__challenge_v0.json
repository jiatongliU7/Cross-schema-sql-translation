  "q_B": {
    "real_estate_properties__challenge_v0__q1030": "SELECT COUNT(*) AS \"_col_0\" FROM \"optional_amenities\" AS \"other_available_features\"",
    "real_estate_properties__challenge_v0__q1031": "SELECT \"t2\".\"asset_category_summary\" AS \"feature_type_name\" FROM \"optional_amenities\" AS \"t1\" JOIN \"asset_category_lookup\" AS \"t2\" ON \"t1\".\"amenity_category_tag\" = \"t2\".\"asset_category_tag\" WHERE \"t1\".\"amenity_label\" = 'AirCon'",
    "real_estate_properties__challenge_v0__q1032": "SELECT \"t2\".\"amenity_category_label\" AS \"property_type_description\" FROM \"realty_assets\" AS \"t1\" JOIN \"amenity_category_lookup\" AS \"t2\" ON \"t1\".\"asset_category_tag\" = \"t2\".\"amenity_category_tag\" GROUP BY \"t1\".\"asset_category_tag\"",
    "real_estate_properties__challenge_v0__q1033": "SELECT \"properties\".\"asset_label\" AS \"property_name\" FROM \"realty_assets\" AS \"properties\" WHERE \"properties\".\"asset_category_tag\" = 'House' UNION SELECT \"properties\".\"asset_label\" AS \"property_name\" FROM \"realty_assets\" AS \"properties\" WHERE \"properties\".\"asset_category_tag\" = 'Apartment' AND \"properties\".\"space_quantity\" > 1"
