  "q_B": {
    "battle_death__syn_v3__q0491": "SELECT COUNT(*) AS \"_col_0\" FROM \"ship\" AS \"ship\" WHERE \"ship\".\"how_vessel_disposed\" = 'Captured'",
    "battle_death__syn_v3__q0497": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"consequence\" AS \"result\" FROM \"battle\" AS \"battle\" WHERE \"battle\".\"bulgarian_head\" <> 'Boril'",
    "battle_death__syn_v3__q0501": "SELECT \"battle\".\"name\" AS \"name\" FROM \"battle\" AS \"battle\" WHERE \"battle\".\"bulgarian_head\" = 'Kaloyan' AND \"battle\".\"latin_commander\" = 'Baldwin I'",
    "battle_death__syn_v3__q0502": "SELECT COUNT(DISTINCT \"battle\".\"consequence\") AS \"_col_0\" FROM \"battle\" AS \"battle\"",
    "battle_death__syn_v3__q0505": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"consequence\" AS \"result\", \"battle\".\"bulgarian_head\" AS \"bulgarian_commander\" FROM \"battle\" AS \"battle\" EXCEPT SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"consequence\" AS \"result\", \"t1\".\"bulgarian_head\" AS \"bulgarian_commander\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"lost_in_battle\" WHERE \"t2\".\"position\" = 'English Channel'"
  },
