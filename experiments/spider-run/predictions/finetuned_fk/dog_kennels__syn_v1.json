  "q_B": {
    "dog_kennels__syn_v1__q0918": "SELECT \"owners\".\"province\" AS \"state\" FROM \"Owners\" AS \"owners\" INTERSECT SELECT \"professionals\".\"state\" AS \"state\" FROM \"Professionals\" AS \"professionals\"",
    "dog_kennels__syn_v1__q0919": "SELECT \"owners\".\"province\" AS \"state\" FROM \"Owners\" AS \"owners\" INTERSECT SELECT \"professionals\".\"state\" AS \"state\" FROM \"Professionals\" AS \"professionals\"",
    "dog_kennels__syn_v1__q0920": "SELECT AVG(\"dogs\".\"age\") AS \"_col_0\" FROM \"Dogs\" AS \"dogs\" WHERE \"dogs\".\"dog_id\" IN (SELECT \"treatments\".\"dog_included\" AS \"dog_id\" FROM \"Treatments\" AS \"treatments\")",
    "dog_kennels__syn_v1__q0921": "SELECT AVG(\"dogs\".\"age\") AS \"_col_0\" FROM \"Dogs\" AS \"dogs\" WHERE \"dogs\".\"dog_id\" IN (SELECT \"treatments\".\"dog_included\" AS \"dog_id\" FROM \"Treatments\" AS \"treatments\")",
    "dog_kennels__syn_v1__q0924": "SELECT \"dogs\".\"name\" AS \"name\" FROM \"Dogs\" AS \"dogs\" WHERE NOT \"dogs\".\"dog_id\" IN (SELECT \"treatments\".\"dog_included\" AS \"dog_id\" FROM \"Treatments\" AS \"treatments\" GROUP BY \"treatments\".\"dog_included\" HAVING SUM(\"treatments\".\"cost_of_treatment\") > 1000)",
    "dog_kennels__syn_v1__q0925": "SELECT \"dogs\".\"name\" AS \"name\" FROM \"Dogs\" AS \"dogs\" WHERE NOT \"dogs\".\"dog_id\" IN (SELECT \"treatments\".\"dog_included\" AS \"dog_id\" FROM \"Treatments\" AS \"treatments\" GROUP BY \"treatments\".\"dog_included\" HAVING SUM(\"treatments\".\"cost_of_treatment\") > 1000)",
    "dog_kennels__syn_v1__q0934": "SELECT \"t1\".\"breed_designation\" AS \"breed_name\" FROM \"Breeds\" AS \"t1\" JOIN \"Dogs\" AS \"t2\" ON \"t1\".\"breed_code\" = \"t2\".\"breed_code\" GROUP BY \"t1\".\"breed_designation\" ORDER BY COUNT(*) DESC LIMIT 1",
    "dog_kennels__syn_v1__q0935": "SELECT \"t1\".\"breed_designation\" AS \"breed_name\" FROM \"Breeds\" AS \"t1\" JOIN \"Dogs\" AS \"t2\" ON \"t1\".\"breed_code\" = \"t2\".\"breed_code\" GROUP BY \"t1\".\"breed_designation\" ORDER BY COUNT(*) DESC LIMIT 1",
    "dog_kennels__syn_v1__q0936": "SELECT \"t1\".\"owner_id\" AS \"owner_id\", \"t1\".\"last_name\" AS \"last_name\" FROM \"Owners\" AS \"t1\" JOIN \"Dogs\" AS \"t2\" ON \"t1\".\"owner_id\" = \"t2\".\"owner_id\" JOIN \"Treatments\" AS \"t3\" ON \"t2\".\"dog_id\" = \"t3\".\"dog_included\" GROUP BY \"t1\".\"owner_id\" ORDER BY COUNT(*) DESC LIMIT 1",
