    "tvshow__syn_v1__q0591": "SELECT \"cartoon\".\"Title\" AS \"title\", \"cartoon\".\"Directed_by\" AS \"directed_by\" FROM \"Cartoon\" AS \"cartoon\" ORDER BY \"cartoon\".\"initial_air_date\"",
    "tvshow__syn_v1__q0592": "SELECT \"cartoon\".\"Title\" AS \"title\", \"cartoon\".\"Directed_by\" AS \"directed_by\" FROM \"Cartoon\" AS \"cartoon\" ORDER BY \"cartoon\".\"initial_air_date\"",
