  "q_B": {
    "museum_visit__syn_v4__q0412": "SELECT \"visitor\".\"Name\" AS \"name\" FROM \"visitor\" AS \"visitor\" WHERE \"visitor\".\"fellowship_classification\" > 4 ORDER BY \"visitor\".\"fellowship_classification\" DESC",
    "museum_visit__syn_v4__q0413": "SELECT AVG(\"visitor\".\"Age\") AS \"_col_0\" FROM \"visitor\" AS \"visitor\" WHERE \"visitor\".\"fellowship_classification\" <= 4",
    "museum_visit__syn_v4__q0414": "SELECT \"visitor\".\"Name\" AS \"name\", \"visitor\".\"fellowship_classification\" AS \"level_of_membership\" FROM \"visitor\" AS \"visitor\" WHERE \"visitor\".\"fellowship_classification\" > 4 ORDER BY \"visitor\".\"Age\" DESC",
    "museum_visit__syn_v4__q0415": "SELECT \"museum\".\"Museum_ID\" AS \"museum_id\", \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" ORDER BY \"museum\".\"staff_num\" DESC LIMIT 1",
    "museum_visit__syn_v4__q0416": "SELECT AVG(\"museum\".\"staff_num\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Open_Year\" < 2009",
    "museum_visit__syn_v4__q0417": "SELECT \"museum\".\"staff_num\" AS \"num_of_staff\", \"museum\".\"Open_Year\" AS \"open_year\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Name\" = 'Plaza Museum'",
    "museum_visit__syn_v4__q0418": "SELECT \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"staff_num\" > (SELECT MIN(\"museum\".\"staff_num\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Open_Year\" > 2010)",
    "museum_visit__syn_v4__q0420": "SELECT \"t2\".\"visitor_ID\" AS \"visitor_id\", \"t1\".\"Name\" AS \"name\", \"t1\".\"fellowship_classification\" AS \"level_of_membership\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" GROUP BY \"t2\".\"visitor_ID\" ORDER BY SUM(\"t2\".\"Total_spent\") DESC LIMIT 1",
    "museum_visit__syn_v4__q0425": "SELECT SUM(\"t2\".\"Total_spent\") AS \"_col_0\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" WHERE \"t1\".\"fellowship_classification\" = 1"
  },
