  "q_B": {
    "wta_1__abbr_v3__q0433": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"dob\" AS \"birth_date\" FROM \"players\" AS \"players\" WHERE \"players\".\"country_code\" = 'USA'",
    "wta_1__abbr_v3__q0434": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"dob\" AS \"birth_date\" FROM \"players\" AS \"players\" WHERE \"players\".\"country_code\" = 'USA'",
    "wta_1__abbr_v3__q0453": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"country_code\" AS \"country_code\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\" LIMIT 1",
    "wta_1__abbr_v3__q0454": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"country_code\" AS \"country_code\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\" LIMIT 1",
    "wta_1__abbr_v3__q0455": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v3__q0456": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v3__q0457": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" WHERE \"players\".\"hand\" = 'L' ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v3__q0458": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" WHERE \"players\".\"hand\" = 'L' ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v3__q0471": "SELECT SUM(\"t2\".\"ranking_pts\") AS \"_col_0\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"rankings\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"player_id\" GROUP BY \"t1\".\"first_name\"",
    "wta_1__abbr_v3__q0472": "SELECT SUM(\"t2\".\"ranking_pts\") AS \"_col_0\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"rankings\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"player_id\" GROUP BY \"t1\".\"first_name\"",
    "wta_1__abbr_v3__q0487": "SELECT \"t1\".\"first_name\" AS \"first_name\", \"t1\".\"country_code\" AS \"country_code\", \"t1\".\"dob\" AS \"birth_date\" FROM \"players\" AS \"t1\" JOIN \"matches\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"winner_id\" ORDER BY \"t2\".\"winner_rank_points\" DESC LIMIT 1",
    "wta_1__abbr_v3__q0488": "SELECT \"t1\".\"first_name\" AS \"first_name\", \"t1\".\"country_code\" AS \"country_code\", \"t1\".\"dob\" AS \"birth_date\" FROM \"players\" AS \"t1\" JOIN \"matches\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"winner_id\" ORDER BY \"t2\".\"winner_rank_points\" DESC LIMIT 1"
  },
