  "q_B": {
    "battle_death__syn_v0__q0492": "SELECT \"ship\".\"name\" AS \"name\", \"ship\".\"vessel\" AS \"tonnage\" FROM \"ship\" AS \"ship\" ORDER BY \"name\" DESC",
    "battle_death__syn_v0__q0496": "SELECT \"t1\".\"killed\" AS \"killed\", \"t1\".\"injured\" AS \"injured\" FROM \"death\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"caused_by_ship_id\" = \"t2\".\"id\" WHERE \"t2\".\"vessel\" = 't'",
    "battle_death__syn_v0__q0497": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"ending\" AS \"result\" FROM \"battle\" AS \"battle\" WHERE \"battle\".\"bulgarian_head\" <> 'Boril'",
    "battle_death__syn_v0__q0498": "SELECT DISTINCT \"t1\".\"id\" AS \"id\", \"t1\".\"name\" AS \"name\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"missed_in_warfare\" WHERE \"t2\".\"spot\" = 'Brig'",
    "battle_death__syn_v0__q0499": "SELECT \"t1\".\"id\" AS \"id\", \"t1\".\"name\" AS \"name\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"missed_in_warfare\" JOIN \"death\" AS \"t3\" ON \"t2\".\"id\" = \"t3\".\"caused_by_ship_id\" GROUP BY \"t1\".\"id\" HAVING SUM(\"t3\".\"killed\") > 10",
    "battle_death__syn_v0__q0501": "SELECT \"battle\".\"name\" AS \"name\" FROM \"battle\" AS \"battle\" WHERE \"battle\".\"bulgarian_head\" = 'Kaloyan' AND \"battle\".\"latin_commander\" = 'Baldwin I'",
    "battle_death__syn_v0__q0502": "SELECT COUNT(DISTINCT \"battle\".\"ending\") AS \"_col_0\" FROM \"battle\" AS \"battle\"",
    "battle_death__syn_v0__q0503": "SELECT COUNT(*) AS \"_col_0\" FROM \"battle\" AS \"battle\" WHERE NOT \"battle\".\"id\" IN (SELECT \"ship\".\"missed_in_warfare\" AS \"lost_in_battle\" FROM \"ship\" AS \"ship\" WHERE \"ship\".\"vessel\" = '225')",
    "battle_death__syn_v0__q0504": "SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"date\" AS \"date\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"missed_in_warfare\" WHERE \"t2\".\"name\" = 'Lettice' INTERSECT SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"date\" AS \"date\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"missed_in_warfare\" WHERE \"t2\".\"name\" = 'HMS Atalanta'",
    "battle_death__syn_v0__q0505": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"ending\" AS \"result\", \"battle\".\"bulgarian_head\" AS \"bulgarian_commander\" FROM \"battle\" AS \"battle\" EXCEPT SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"ending\" AS \"result\", \"t1\".\"bulgarian_head\" AS \"bulgarian_commander\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"missed_in_warfare\" WHERE \"t2\".\"craft_classification\" = 'English Channel'",
    "battle_death__syn_v0__q0506": "SELECT \"death\".\"mark\" AS \"note\" FROM \"death\" AS \"death\" WHERE \"death\".\"mark\" LIKE '%East%'"
  },
