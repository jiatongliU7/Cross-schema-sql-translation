  "q_B": {
    "dog_kennels__syn_v2__q0924": "SELECT \"dogs\".\"name\" AS \"name\" FROM \"Dogs\" AS \"dogs\" WHERE NOT \"dogs\".\"dog_id\" IN (SELECT \"treatments\".\"dog_id\" AS \"dog_id\" FROM \"Treatments\" AS \"treatments\" GROUP BY \"treatments\".\"dog_id\" HAVING SUM(\"treatments\".\"charge_of_curative\") > 1000)",
    "dog_kennels__syn_v2__q0925": "SELECT \"dogs\".\"name\" AS \"name\" FROM \"Dogs\" AS \"dogs\" WHERE NOT \"dogs\".\"dog_id\" IN (SELECT \"treatments\".\"dog_id\" AS \"dog_id\" FROM \"Treatments\" AS \"treatments\" GROUP BY \"treatments\".\"dog_id\" HAVING SUM(\"treatments\".\"charge_of_curative\") > 1000)",
    "dog_kennels__syn_v2__q0928": "SELECT \"professionals\".\"professional_id\" AS \"professional_id\", \"professionals\".\"role_code\" AS \"role_code\", \"professionals\".\"mail\" AS \"email_address\" FROM \"Professionals\" AS \"professionals\" EXCEPT SELECT \"t1\".\"professional_id\" AS \"professional_id\", \"t1\".\"role_code\" AS \"role_code\", \"t1\".\"mail\" AS \"email_address\" FROM \"Professionals\" AS \"t1\" JOIN \"Treatments\" AS \"t2\" ON \"t1\".\"professional_id\" = \"t2\".\"professional_id\"",
    "dog_kennels__syn_v2__q0929": "SELECT \"professionals\".\"professional_id\" AS \"professional_id\", \"professionals\".\"role_code\" AS \"role_code\", \"professionals\".\"mail\" AS \"email_address\" FROM \"Professionals\" AS \"professionals\" EXCEPT SELECT \"t1\".\"professional_id\" AS \"professional_id\", \"t1\".\"role_code\" AS \"role_code\", \"t1\".\"mail\" AS \"email_address\" FROM \"Professionals\" AS \"t1\" JOIN \"Treatments\" AS \"t2\" ON \"t1\".\"professional_id\" = \"t2\".\"professional_id\"",
    "dog_kennels__syn_v2__q0938": "SELECT \"t1\".\"treatment_type_description\" AS \"treatment_type_description\" FROM \"Treatment_Types\" AS \"t1\" JOIN \"Treatments\" AS \"t2\" ON \"t1\".\"treatment_type_code\" = \"t2\".\"treatment_type_code\" GROUP BY \"t1\".\"treatment_type_code\" ORDER BY SUM(\"t2\".\"charge_of_curative\") ASC LIMIT 1",
    "dog_kennels__syn_v2__q0939": "SELECT \"t1\".\"treatment_type_description\" AS \"treatment_type_description\" FROM \"Treatment_Types\" AS \"t1\" JOIN \"Treatments\" AS \"t2\" ON \"t1\".\"treatment_type_code\" = \"t2\".\"treatment_type_code\" GROUP BY \"t1\".\"treatment_type_code\" ORDER BY SUM(\"t2\".\"charge_of_curative\") ASC LIMIT 1",
    "dog_kennels__syn_v2__q0940": "SELECT \"t1\".\"owner_id\" AS \"owner_id\", \"t1\".\"zip_code\" AS \"zip_code\" FROM \"Owners\" AS \"t1\" JOIN \"Dogs\" AS \"t2\" ON \"t1\".\"owner_id\" = \"t2\".\"owner_id\" JOIN \"Treatments\" AS \"t3\" ON \"t2\".\"dog_id\" = \"t3\".\"dog_id\" GROUP BY \"t1\".\"owner_id\" ORDER BY SUM(\"t3\".\"charge_of_curative\") DESC LIMIT 1",
    "dog_kennels__syn_v2__q0941": "SELECT \"t1\".\"owner_id\" AS \"owner_id\", \"t1\".\"zip_code\" AS \"zip_code\" FROM \"Owners\" AS \"t1\" JOIN \"Dogs\" AS \"t2\" ON \"t1\".\"owner_id\" = \"t2\".\"owner_id\" JOIN \"Treatments\" AS \"t3\" ON \"t2\".\"dog_id\" = \"t3\".\"dog_id\" GROUP BY \"t1\".\"owner_id\" ORDER BY SUM(\"t3\".\"charge_of_curative\") DESC LIMIT 1",
    "dog_kennels__syn_v2__q0944": "SELECT DISTINCT \"t1\".\"first_name\" AS \"first_name\", \"t1\".\"last_name\" AS \"last_name\" FROM \"Professionals\" AS \"t1\" JOIN \"Treatments\" AS \"t2\" ON TRUE WHERE \"t2\".\"charge_of_curative\" < (SELECT AVG(\"treatments\".\"charge_of_curative\") AS \"_col_0\" FROM \"Treatments\" AS \"treatments\")",
