    "dog_kennels__abbr_v2__q0971": "SELECT \"professionals\".\"role_code\" AS \"role_code\", \"professionals\".\"st\" AS \"street\", \"professionals\".\"city\" AS \"city\", \"professionals\".\"state\" AS \"state\" FROM \"Professionals\" AS \"professionals\" WHERE \"professionals\".\"city\" LIKE '%West%'",
    "dog_kennels__abbr_v2__q0984": "SELECT \"dogs\".\"name\" AS \"name\", \"dogs\".\"age\" AS \"age\", \"dogs\".\"wt\" AS \"weight\" FROM \"Dogs\" AS \"dogs\" WHERE \"dogs\".\"abandoned_yn\" = 1",
