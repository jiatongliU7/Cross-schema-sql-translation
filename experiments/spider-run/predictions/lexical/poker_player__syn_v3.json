    "poker_player__syn_v3__q0651": "SELECT \"poker_player\".\"last_table_made\" AS \"final_table_made\", \"poker_player\".\"Best_Finish\" AS \"best_finish\" FROM \"poker_player\" AS \"poker_player\"",
    "poker_player__syn_v3__q0652": "SELECT \"poker_player\".\"last_table_made\" AS \"final_table_made\", \"poker_player\".\"Best_Finish\" AS \"best_finish\" FROM \"poker_player\" AS \"poker_player\"",
