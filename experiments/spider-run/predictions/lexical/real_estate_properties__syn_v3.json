  "q_B": {
    "real_estate_properties__syn_v3__q1031": "SELECT \"t2\".\"property_type_name\" AS \"feature_type_name\" FROM \"Other_Available_Features\" AS \"t1\" JOIN \"Ref_Feature_Types\" AS \"t2\" ON \"t1\".\"feature_type_code\" = \"t2\".\"attribute_category_num\" WHERE \"t1\".\"feature_name\" = 'AirCon'",
    "real_estate_properties__syn_v3__q1032": "SELECT \"t2\".\"property_type_description\" AS \"property_type_description\" FROM \"Properties\" AS \"t1\" JOIN \"Ref_Property_Types\" AS \"t2\" ON \"t1\".\"possessions_class_num\" = \"t2\".\"property_type_code\" GROUP BY \"t1\".\"possessions_class_num\"",
    "real_estate_properties__syn_v3__q1033": "SELECT \"properties\".\"property_cognomen\" AS \"property_name\" FROM \"Properties\" AS \"properties\" WHERE \"properties\".\"possessions_class_num\" = 'House' UNION SELECT \"properties\".\"property_cognomen\" AS \"property_name\" FROM \"Properties\" AS \"properties\" WHERE \"properties\".\"possessions_class_num\" = 'Apartment' AND \"properties\".\"room_count\" > 1"
  },
