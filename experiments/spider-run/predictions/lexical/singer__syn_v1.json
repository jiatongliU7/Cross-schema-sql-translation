    "singer__syn_v1__q1004": "SELECT \"singer\".\"born_yr\" AS \"birth_year\", \"singer\".\"Citizenship\" AS \"citizenship\" FROM \"singer\" AS \"singer\"",
    "singer__syn_v1__q1005": "SELECT \"singer\".\"born_yr\" AS \"birth_year\", \"singer\".\"Citizenship\" AS \"citizenship\" FROM \"singer\" AS \"singer\"",
    "singer__syn_v1__q1008": "SELECT \"singer\".\"Name\" AS \"name\" FROM \"singer\" AS \"singer\" WHERE \"singer\".\"born_yr\" = 1948 OR \"singer\".\"born_yr\" = 1949",
    "singer__syn_v1__q1009": "SELECT \"singer\".\"Name\" AS \"name\" FROM \"singer\" AS \"singer\" WHERE \"singer\".\"born_yr\" = 1948 OR \"singer\".\"born_yr\" = 1949",
    "singer__syn_v1__q1020": "SELECT DISTINCT \"t1\".\"Name\" AS \"name\" FROM \"singer\" AS \"t1\" JOIN \"song\" AS \"t2\" ON \"t1\".\"Singer_ID\" = \"t2\".\"Singer_ID\" WHERE \"t2\".\"sold\" > 300000",
    "singer__syn_v1__q1021": "SELECT DISTINCT \"t1\".\"Name\" AS \"name\" FROM \"singer\" AS \"t1\" JOIN \"song\" AS \"t2\" ON \"t1\".\"Singer_ID\" = \"t2\".\"Singer_ID\" WHERE \"t2\".\"sold\" > 300000",
    "singer__syn_v1__q1024": "SELECT \"t1\".\"Name\" AS \"name\", SUM(\"t2\".\"sold\") AS \"_col_1\" FROM \"singer\" AS \"t1\" JOIN \"song\" AS \"t2\" ON \"t1\".\"Singer_ID\" = \"t2\".\"Singer_ID\" GROUP BY \"t1\".\"Name\"",
    "singer__syn_v1__q1025": "SELECT \"t1\".\"Name\" AS \"name\", SUM(\"t2\".\"sold\") AS \"_col_1\" FROM \"singer\" AS \"t1\" JOIN \"song\" AS \"t2\" ON \"t1\".\"Singer_ID\" = \"t2\".\"Singer_ID\" GROUP BY \"t1\".\"Name\"",
