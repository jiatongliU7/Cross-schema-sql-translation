    "employee_hire_evaluation__syn_v2__q0270": "SELECT \"shop\".\"Manager_name\" AS \"manager_name\", \"shop\".\"District\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"products_number\" DESC LIMIT 1",
