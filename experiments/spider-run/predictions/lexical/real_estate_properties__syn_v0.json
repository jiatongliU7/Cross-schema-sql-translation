  "q_B": {
    "real_estate_properties__syn_v0__q1031": "SELECT \"t2\".\"characteristics_type_name\" AS \"feature_type_name\" FROM \"Other_Available_Features\" AS \"t1\" JOIN \"Ref_Feature_Types\" AS \"t2\" ON \"t1\".\"attribute_type_num\" = \"t2\".\"attribute_category_number\" WHERE \"t1\".\"attribute_appellation\" = 'AirCon'",
    "real_estate_properties__syn_v0__q1032": "SELECT \"t2\".\"category_details\" AS \"property_type_description\" FROM \"Properties\" AS \"t1\" JOIN \"Ref_Property_Types\" AS \"t2\" ON \"t1\".\"type_of_property\" = \"t2\".\"property_type_code\" GROUP BY \"t1\".\"type_of_property\"",
    "real_estate_properties__syn_v0__q1033": "SELECT \"properties\".\"property_name\" AS \"property_name\" FROM \"Properties\" AS \"properties\" WHERE \"properties\".\"type_of_property\" = 'House' UNION SELECT \"properties\".\"property_name\" AS \"property_name\" FROM \"Properties\" AS \"properties\" WHERE \"properties\".\"type_of_property\" = 'Apartment' AND \"properties\".\"total_room\" > 1"
  },
