    "tvshow__syn_v1__q0591": "SELECT \"cartoon\".\"Title\" AS \"title\", \"cartoon\".\"Directed_by\" AS \"directed_by\" FROM \"Cartoon\" AS \"cartoon\" ORDER BY \"cartoon\".\"initial_air_date\"",
    "tvshow__syn_v1__q0592": "SELECT \"cartoon\".\"Title\" AS \"title\", \"cartoon\".\"Directed_by\" AS \"directed_by\" FROM \"Cartoon\" AS \"cartoon\" ORDER BY \"cartoon\".\"initial_air_date\"",
    "tvshow__syn_v1__q0613": "SELECT \"tv_series\".\"chapter\" AS \"episode\" FROM \"TV_series\" AS \"tv_series\" ORDER BY \"tv_series\".\"Rating\"",
    "tvshow__syn_v1__q0614": "SELECT \"tv_series\".\"chapter\" AS \"episode\" FROM \"TV_series\" AS \"tv_series\" ORDER BY \"tv_series\".\"Rating\"",
    "tvshow__syn_v1__q0615": "SELECT \"tv_series\".\"chapter\" AS \"episode\", \"tv_series\".\"Rating\" AS \"rating\" FROM \"TV_series\" AS \"tv_series\" ORDER BY \"rating\" DESC LIMIT 3",
    "tvshow__syn_v1__q0616": "SELECT \"tv_series\".\"chapter\" AS \"episode\", \"tv_series\".\"Rating\" AS \"rating\" FROM \"TV_series\" AS \"tv_series\" ORDER BY \"rating\" DESC LIMIT 3",
    "tvshow__syn_v1__q0619": "SELECT \"tv_series\".\"Air_Date\" AS \"air_date\" FROM \"TV_series\" AS \"tv_series\" WHERE \"tv_series\".\"chapter\" = 'A Love of a Lifetime'",
    "tvshow__syn_v1__q0620": "SELECT \"tv_series\".\"Air_Date\" AS \"air_date\" FROM \"TV_series\" AS \"tv_series\" WHERE \"tv_series\".\"chapter\" = 'A Love of a Lifetime'",
    "tvshow__syn_v1__q0621": "SELECT \"tv_series\".\"every_week_ranking\" AS \"weekly_rank\" FROM \"TV_series\" AS \"tv_series\" WHERE \"tv_series\".\"chapter\" = 'A Love of a Lifetime'",
    "tvshow__syn_v1__q0622": "SELECT \"tv_series\".\"every_week_ranking\" AS \"weekly_rank\" FROM \"TV_series\" AS \"tv_series\" WHERE \"tv_series\".\"chapter\" = 'A Love of a Lifetime'",
    "tvshow__syn_v1__q0623": "SELECT \"t1\".\"series_name\" AS \"series_name\" FROM \"TV_Channel\" AS \"t1\" JOIN \"TV_series\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"tv_channel\" WHERE \"t2\".\"chapter\" = 'A Love of a Lifetime'",
    "tvshow__syn_v1__q0624": "SELECT \"t1\".\"series_name\" AS \"series_name\" FROM \"TV_Channel\" AS \"t1\" JOIN \"TV_series\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"tv_channel\" WHERE \"t2\".\"chapter\" = 'A Love of a Lifetime'",
    "tvshow__syn_v1__q0625": "SELECT \"t2\".\"chapter\" AS \"episode\" FROM \"TV_Channel\" AS \"t1\" JOIN \"TV_series\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"tv_channel\" WHERE \"t1\".\"series_name\" = 'Sky Radio'",
    "tvshow__syn_v1__q0626": "SELECT \"t2\".\"chapter\" AS \"episode\" FROM \"TV_Channel\" AS \"t1\" JOIN \"TV_series\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"tv_channel\" WHERE \"t1\".\"series_name\" = 'Sky Radio'",
    "tvshow__syn_v1__q0629": "SELECT \"cartoon\".\"manufacture_codification\" AS \"production_code\", \"cartoon\".\"Channel\" AS \"channel\" FROM \"Cartoon\" AS \"cartoon\" ORDER BY \"cartoon\".\"initial_air_date\" DESC LIMIT 1",
