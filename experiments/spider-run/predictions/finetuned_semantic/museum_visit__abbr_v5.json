  "q_B": {
    "museum_visit__abbr_v5__q0415": "SELECT \"museum\".\"mus_id\" AS \"museum_id\", \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" ORDER BY \"museum\".\"num_stf\" DESC LIMIT 1",
    "museum_visit__abbr_v5__q0416": "SELECT AVG(\"museum\".\"num_stf\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Open_Year\" < 2009",
    "museum_visit__abbr_v5__q0417": "SELECT \"museum\".\"num_stf\" AS \"num_of_staff\", \"museum\".\"Open_Year\" AS \"open_year\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Name\" = 'Plaza Museum'",
    "museum_visit__abbr_v5__q0418": "SELECT \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"num_stf\" > (SELECT MIN(\"museum\".\"num_stf\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Open_Year\" > 2010)",
    "museum_visit__abbr_v5__q0421": "SELECT \"t2\".\"Museum_ID\" AS \"museum_id\", \"t1\".\"Name\" AS \"name\" FROM \"museum\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"mus_id\" = \"t2\".\"Museum_ID\" GROUP BY \"t2\".\"Museum_ID\" ORDER BY COUNT(*) DESC LIMIT 1",
    "museum_visit__abbr_v5__q0422": "SELECT \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" WHERE NOT \"museum\".\"mus_id\" IN (SELECT \"visit\".\"Museum_ID\" AS \"museum_id\" FROM \"visit\" AS \"visit\")",
    "museum_visit__abbr_v5__q0426": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" JOIN \"museum\" AS \"t3\" ON \"t3\".\"mus_id\" = \"t2\".\"Museum_ID\" WHERE \"t3\".\"Open_Year\" < 2009 INTERSECT SELECT \"t1\".\"Name\" AS \"name\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" JOIN \"museum\" AS \"t3\" ON \"t3\".\"mus_id\" = \"t2\".\"Museum_ID\" WHERE \"t3\".\"Open_Year\" > 2011",
    "museum_visit__abbr_v5__q0427": "SELECT COUNT(*) AS \"_col_0\" FROM \"visitor\" AS \"visitor\" WHERE NOT \"visitor\".\"ID\" IN (SELECT \"t2\".\"visitor_ID\" AS \"visitor_id\" FROM \"museum\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"mus_id\" = \"t2\".\"Museum_ID\" WHERE \"t1\".\"Open_Year\" > 2010)"
  },
