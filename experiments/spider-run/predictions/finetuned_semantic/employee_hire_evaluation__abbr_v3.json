    "employee_hire_evaluation__abbr_v3__q0273": "SELECT \"shop\".\"Name\" AS \"name\", \"shop\".\"Location\" AS \"location\", \"shop\".\"dist\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"Number_products\" DESC",
    "employee_hire_evaluation__abbr_v3__q0274": "SELECT \"shop\".\"Name\" AS \"name\", \"shop\".\"Location\" AS \"location\", \"shop\".\"dist\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"Number_products\" DESC",
