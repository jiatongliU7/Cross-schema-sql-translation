    "employee_hire_evaluation__abbr_v3__q0269": "SELECT \"shop\".\"Manager_name\" AS \"manager_name\", \"shop\".\"dist\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"Number_products\" DESC LIMIT 1",
    "employee_hire_evaluation__abbr_v3__q0270": "SELECT \"shop\".\"Manager_name\" AS \"manager_name\", \"shop\".\"dist\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"Number_products\" DESC LIMIT 1",
    "employee_hire_evaluation__abbr_v3__q0273": "SELECT \"shop\".\"Name\" AS \"name\", \"shop\".\"Location\" AS \"location\", \"shop\".\"dist\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"Number_products\" DESC",
    "employee_hire_evaluation__abbr_v3__q0274": "SELECT \"shop\".\"Name\" AS \"name\", \"shop\".\"Location\" AS \"location\", \"shop\".\"dist\" AS \"district\" FROM \"shop\" AS \"shop\" ORDER BY \"shop\".\"Number_products\" DESC",
    "employee_hire_evaluation__abbr_v3__q0277": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"employee\" AS \"t1\" JOIN \"evaluation\" AS \"t2\" ON \"t1\".\"ee_id\" = \"t2\".\"Employee_ID\" GROUP BY \"t2\".\"Employee_ID\" ORDER BY COUNT(*) DESC LIMIT 1",
    "employee_hire_evaluation__abbr_v3__q0278": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"employee\" AS \"t1\" JOIN \"evaluation\" AS \"t2\" ON \"t1\".\"ee_id\" = \"t2\".\"Employee_ID\" GROUP BY \"t2\".\"Employee_ID\" ORDER BY COUNT(*) DESC LIMIT 1",
    "employee_hire_evaluation__abbr_v3__q0279": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"employee\" AS \"t1\" JOIN \"evaluation\" AS \"t2\" ON \"t1\".\"ee_id\" = \"t2\".\"Employee_ID\" ORDER BY \"t2\".\"Bonus\" DESC LIMIT 1",
    "employee_hire_evaluation__abbr_v3__q0280": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"employee\" AS \"t1\" JOIN \"evaluation\" AS \"t2\" ON \"t1\".\"ee_id\" = \"t2\".\"Employee_ID\" ORDER BY \"t2\".\"Bonus\" DESC LIMIT 1",
    "employee_hire_evaluation__abbr_v3__q0281": "SELECT \"employee\".\"Name\" AS \"name\" FROM \"employee\" AS \"employee\" WHERE NOT \"employee\".\"ee_id\" IN (SELECT \"evaluation\".\"Employee_ID\" AS \"employee_id\" FROM \"evaluation\" AS \"evaluation\")",
