    "museum_visit__syn_v2__q0416": "SELECT AVG(\"museum\".\"Num_of_Staff\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"airing_year\" < 2009",
    "museum_visit__syn_v2__q0417": "SELECT \"museum\".\"Num_of_Staff\" AS \"num_of_staff\", \"museum\".\"airing_year\" AS \"open_year\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Name\" = 'Plaza Museum'",
    "museum_visit__syn_v2__q0418": "SELECT \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Num_of_Staff\" > (SELECT MIN(\"museum\".\"Num_of_Staff\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"airing_year\" > 2010)",
    "museum_visit__syn_v2__q0426": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" JOIN \"museum\" AS \"t3\" ON \"t3\".\"Museum_ID\" = \"t2\".\"Museum_ID\" WHERE \"t3\".\"airing_year\" < 2009 INTERSECT SELECT \"t1\".\"Name\" AS \"name\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" JOIN \"museum\" AS \"t3\" ON \"t3\".\"Museum_ID\" = \"t2\".\"Museum_ID\" WHERE \"t3\".\"airing_year\" > 2011",
    "museum_visit__syn_v2__q0427": "SELECT COUNT(*) AS \"_col_0\" FROM \"visitor\" AS \"visitor\" WHERE NOT \"visitor\".\"ID\" IN (SELECT \"t2\".\"visitor_ID\" AS \"visitor_id\" FROM \"museum\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"Museum_ID\" = \"t2\".\"Museum_ID\" WHERE \"t1\".\"airing_year\" > 2010)",
