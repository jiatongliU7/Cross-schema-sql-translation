  "q_B": {
    "real_estate_properties__abbr_v2__q1031": "SELECT \"t2\".\"feature_type_name\" AS \"feature_type_name\" FROM \"Other_Available_Features\" AS \"t1\" JOIN \"Ref_Feature_Types\" AS \"t2\" ON \"t1\".\"feature_type_code\" = \"t2\".\"feat_type_code\" WHERE \"t1\".\"feat_name\" = 'AirCon'",
    "real_estate_properties__abbr_v2__q1032": "SELECT \"t2\".\"prop_type_desc\" AS \"property_type_description\" FROM \"Properties\" AS \"t1\" JOIN \"Ref_Property_Types\" AS \"t2\" ON \"t1\".\"prop_type_code\" = \"t2\".\"property_type_code\" GROUP BY \"t1\".\"prop_type_code\"",
    "real_estate_properties__abbr_v2__q1033": "SELECT \"properties\".\"prop_name\" AS \"property_name\" FROM \"Properties\" AS \"properties\" WHERE \"properties\".\"prop_type_code\" = 'House' UNION SELECT \"properties\".\"prop_name\" AS \"property_name\" FROM \"Properties\" AS \"properties\" WHERE \"properties\".\"prop_type_code\" = 'Apartment' AND \"properties\".\"room_count\" > 1"
  },
