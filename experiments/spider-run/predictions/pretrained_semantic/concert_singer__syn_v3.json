    "concert_singer__syn_v3__q0006": "SELECT \"singer\".\"Song_Name\" AS \"song_name\", \"singer\".\"air_date\" AS \"song_release_year\" FROM \"singer\" AS \"singer\" ORDER BY \"singer\".\"Age\" LIMIT 1",
    "concert_singer__syn_v3__q0007": "SELECT \"singer\".\"Song_Name\" AS \"song_name\", \"singer\".\"air_date\" AS \"song_release_year\" FROM \"singer\" AS \"singer\" ORDER BY \"singer\".\"Age\" LIMIT 1",
    "concert_singer__syn_v3__q0014": "SELECT \"stadium\".\"whereabouts\" AS \"location\", \"stadium\".\"Name\" AS \"name\" FROM \"stadium\" AS \"stadium\" WHERE \"stadium\".\"Capacity\" BETWEEN 5000 AND 10000",
    "concert_singer__syn_v3__q0015": "SELECT \"stadium\".\"whereabouts\" AS \"location\", \"stadium\".\"Name\" AS \"name\" FROM \"stadium\" AS \"stadium\" WHERE \"stadium\".\"Capacity\" BETWEEN 5000 AND 10000",
    "concert_singer__syn_v3__q0016": "SELECT MAX(\"stadium\".\"Capacity\") AS \"_col_0\", \"stadium\".\"mean\" AS \"average\" FROM \"stadium\" AS \"stadium\"",
    "concert_singer__syn_v3__q0018": "SELECT \"stadium\".\"Name\" AS \"name\", \"stadium\".\"Capacity\" AS \"capacity\" FROM \"stadium\" AS \"stadium\" ORDER BY \"stadium\".\"mean\" DESC LIMIT 1",
    "concert_singer__syn_v3__q0019": "SELECT \"stadium\".\"Name\" AS \"name\", \"stadium\".\"Capacity\" AS \"capacity\" FROM \"stadium\" AS \"stadium\" ORDER BY \"stadium\".\"mean\" DESC LIMIT 1",
    "concert_singer__syn_v3__q0033": "SELECT \"t2\".\"concert_Name\" AS \"concert_name\", \"t2\".\"category\" AS \"theme\", COUNT(*) AS \"_col_2\" FROM \"singer_in_concert\" AS \"t1\" JOIN \"concert\" AS \"t2\" ON \"t1\".\"concert_ID\" = \"t2\".\"concert_ID\" GROUP BY \"t2\".\"concert_ID\"",
    "concert_singer__syn_v3__q0034": "SELECT \"t2\".\"concert_Name\" AS \"concert_name\", \"t2\".\"category\" AS \"theme\", COUNT(*) AS \"_col_2\" FROM \"singer_in_concert\" AS \"t1\" JOIN \"concert\" AS \"t2\" ON \"t1\".\"concert_ID\" = \"t2\".\"concert_ID\" GROUP BY \"t2\".\"concert_ID\"",
    "concert_singer__syn_v3__q0041": "SELECT \"t2\".\"Name\" AS \"name\", \"t2\".\"whereabouts\" AS \"location\" FROM \"concert\" AS \"t1\" JOIN \"stadium\" AS \"t2\" ON \"t1\".\"Stadium_ID\" = \"t2\".\"Stadium_ID\" WHERE \"t1\".\"Year\" = 2014 INTERSECT SELECT \"t2\".\"Name\" AS \"name\", \"t2\".\"whereabouts\" AS \"location\" FROM \"concert\" AS \"t1\" JOIN \"stadium\" AS \"t2\" ON \"t1\".\"Stadium_ID\" = \"t2\".\"Stadium_ID\" WHERE \"t1\".\"Year\" = 2015",
