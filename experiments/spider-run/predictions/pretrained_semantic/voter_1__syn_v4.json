    "voter_1__syn_v4__q0689": "SELECT \"votes\".\"vote_id\" AS \"vote_id\", \"votes\".\"call_up\" AS \"phone_number\", \"votes\".\"state\" AS \"state\" FROM \"VOTES\" AS \"votes\"",
    "voter_1__syn_v4__q0691": "SELECT MAX(\"votes\".\"made\") AS \"_col_0\" FROM \"VOTES\" AS \"votes\" WHERE \"votes\".\"state\" = 'CA'",
