    "voter_1__syn_v4__q0699": "SELECT \"t2\".\"made\" AS \"created\", \"t2\".\"state\" AS \"state\", \"t2\".\"call_up\" AS \"phone_number\" FROM \"CONTESTANTS\" AS \"t1\" JOIN \"VOTES\" AS \"t2\" ON \"t1\".\"contestant_number\" = \"t2\".\"contestant_number\" WHERE \"t1\".\"contestant_name\" = 'Tabatha Gehling'"
