  "q_B": {
    "battle_death__syn_v2__q0492": "SELECT \"ship\".\"name\" AS \"name\", \"ship\".\"heaviness\" AS \"tonnage\" FROM \"ship\" AS \"ship\" ORDER BY \"name\" DESC",
    "battle_death__syn_v2__q0496": "SELECT \"t1\".\"killed\" AS \"killed\", \"t1\".\"injured\" AS \"injured\" FROM \"death\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"caused_by_ship_id\" = \"t2\".\"id\" WHERE \"t2\".\"heaviness\" = 't'",
    "battle_death__syn_v2__q0503": "SELECT COUNT(*) AS \"_col_0\" FROM \"battle\" AS \"battle\" WHERE NOT \"battle\".\"id\" IN (SELECT \"ship\".\"lost_in_battle\" AS \"lost_in_battle\" FROM \"ship\" AS \"ship\" WHERE \"ship\".\"heaviness\" = '225')"
