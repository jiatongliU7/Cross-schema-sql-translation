  "q_B": {
    "battle_death__syn_v4__q0491": "SELECT COUNT(*) AS \"_col_0\" FROM \"ship\" AS \"ship\" WHERE \"ship\".\"how_ship_disposed\" = 'Captured'",
    "battle_death__syn_v4__q0497": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"effect\" AS \"result\" FROM \"battle\" AS \"battle\" WHERE \"battle\".\"bulgarian_commander\" <> 'Boril'",
    "battle_death__syn_v4__q0498": "SELECT DISTINCT \"t1\".\"id\" AS \"id\", \"t1\".\"name\" AS \"name\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"forfeited_in_combat\" WHERE \"t2\".\"ship_type\" = 'Brig'",
    "battle_death__syn_v4__q0499": "SELECT \"t1\".\"id\" AS \"id\", \"t1\".\"name\" AS \"name\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"forfeited_in_combat\" JOIN \"death\" AS \"t3\" ON \"t2\".\"id\" = \"t3\".\"caused_by_ship_id\" GROUP BY \"t1\".\"id\" HAVING SUM(\"t3\".\"killed\") > 10",
    "battle_death__syn_v4__q0502": "SELECT COUNT(DISTINCT \"battle\".\"effect\") AS \"_col_0\" FROM \"battle\" AS \"battle\"",
    "battle_death__syn_v4__q0503": "SELECT COUNT(*) AS \"_col_0\" FROM \"battle\" AS \"battle\" WHERE NOT \"battle\".\"id\" IN (SELECT \"ship\".\"forfeited_in_combat\" AS \"lost_in_battle\" FROM \"ship\" AS \"ship\" WHERE \"ship\".\"tonnage\" = '225')",
    "battle_death__syn_v4__q0504": "SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"date\" AS \"date\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"forfeited_in_combat\" WHERE \"t2\".\"name\" = 'Lettice' INTERSECT SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"date\" AS \"date\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"forfeited_in_combat\" WHERE \"t2\".\"name\" = 'HMS Atalanta'",
    "battle_death__syn_v4__q0505": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"effect\" AS \"result\", \"battle\".\"bulgarian_commander\" AS \"bulgarian_commander\" FROM \"battle\" AS \"battle\" EXCEPT SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"effect\" AS \"result\", \"t1\".\"bulgarian_commander\" AS \"bulgarian_commander\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"forfeited_in_combat\" WHERE \"t2\".\"location\" = 'English Channel'",
    "battle_death__syn_v4__q0506": "SELECT \"death\".\"info\" AS \"note\" FROM \"death\" AS \"death\" WHERE \"death\".\"info\" LIKE '%East%'"
  },
