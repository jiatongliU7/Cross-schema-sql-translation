    "orchestra__abbr_v1__q0847": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"conductor\" AS \"t1\" JOIN \"orchestra\" AS \"t2\" ON \"t1\".\"cond_id\" = \"t2\".\"cond_id\" WHERE \"t2\".\"Year_of_Founded\" > 2008",
    "orchestra__abbr_v1__q0850": "SELECT \"orchestra\".\"maj_fmt\" AS \"major_record_format\" FROM \"orchestra\" AS \"orchestra\" GROUP BY \"orchestra\".\"maj_fmt\" ORDER BY COUNT(*) ASC",
