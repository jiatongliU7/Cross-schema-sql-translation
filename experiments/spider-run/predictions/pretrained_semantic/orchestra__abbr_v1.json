    "orchestra__abbr_v1__q0841": "SELECT \"t1\".\"Name\" AS \"name\", \"t2\".\"Orchestra\" AS \"orchestra\" FROM \"conductor\" AS \"t1\" JOIN \"orchestra\" AS \"t2\" ON \"t1\".\"cond_id\" = \"t2\".\"cond_id\"",
    "orchestra__abbr_v1__q0842": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"conductor\" AS \"t1\" JOIN \"orchestra\" AS \"t2\" ON \"t1\".\"cond_id\" = \"t2\".\"cond_id\" GROUP BY \"t2\".\"cond_id\" HAVING COUNT(*) > 1",
    "orchestra__abbr_v1__q0843": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"conductor\" AS \"t1\" JOIN \"orchestra\" AS \"t2\" ON \"t1\".\"cond_id\" = \"t2\".\"cond_id\" GROUP BY \"t2\".\"cond_id\" HAVING COUNT(*) > 1",
    "orchestra__abbr_v1__q0844": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"conductor\" AS \"t1\" JOIN \"orchestra\" AS \"t2\" ON \"t1\".\"cond_id\" = \"t2\".\"cond_id\" GROUP BY \"t2\".\"cond_id\" ORDER BY COUNT(*) DESC LIMIT 1",
    "orchestra__abbr_v1__q0845": "SELECT \"t1\".\"Name\" AS \"name\" FROM \"conductor\" AS \"t1\" JOIN \"orchestra\" AS \"t2\" ON \"t1\".\"cond_id\" = \"t2\".\"cond_id\" GROUP BY \"t2\".\"cond_id\" ORDER BY COUNT(*) DESC LIMIT 1",
