    "real_estate_properties__abbr_v4__q1031": "SELECT \"t2\".\"feature_type_name\" AS \"feature_type_name\" FROM \"Other_Available_Features\" AS \"t1\" JOIN \"Ref_Feature_Types\" AS \"t2\" ON \"t1\".\"feat_type_code\" = \"t2\".\"feature_type_code\" WHERE \"t1\".\"feature_name\" = 'AirCon'",
