    "wta_1__abbr_v0__q0433": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"dob\" AS \"birth_date\" FROM \"players\" AS \"players\" WHERE \"players\".\"cntry_code\" = 'USA'",
    "wta_1__abbr_v0__q0434": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"dob\" AS \"birth_date\" FROM \"players\" AS \"players\" WHERE \"players\".\"cntry_code\" = 'USA'",
    "wta_1__abbr_v0__q0441": "SELECT COUNT(DISTINCT \"players\".\"cntry_code\") AS \"_col_0\" FROM \"players\" AS \"players\"",
    "wta_1__abbr_v0__q0442": "SELECT COUNT(DISTINCT \"players\".\"cntry_code\") AS \"_col_0\" FROM \"players\" AS \"players\"",
    "wta_1__abbr_v0__q0451": "SELECT \"t1\".\"cntry_code\" AS \"country_code\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"matches\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"winner_id\" WHERE \"t2\".\"tourney_name\" = 'WTA Championships' INTERSECT SELECT \"t1\".\"cntry_code\" AS \"country_code\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"matches\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"winner_id\" WHERE \"t2\".\"tourney_name\" = 'Australian Open'",
    "wta_1__abbr_v0__q0452": "SELECT \"t1\".\"cntry_code\" AS \"country_code\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"matches\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"winner_id\" WHERE \"t2\".\"tourney_name\" = 'WTA Championships' INTERSECT SELECT \"t1\".\"cntry_code\" AS \"country_code\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"matches\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"winner_id\" WHERE \"t2\".\"tourney_name\" = 'Australian Open'",
    "wta_1__abbr_v0__q0453": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"cntry_code\" AS \"country_code\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\" LIMIT 1",
    "wta_1__abbr_v0__q0454": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"cntry_code\" AS \"country_code\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\" LIMIT 1",
    "wta_1__abbr_v0__q0455": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v0__q0456": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v0__q0457": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" WHERE \"players\".\"hand\" = 'L' ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v0__q0458": "SELECT \"players\".\"first_name\" AS \"first_name\", \"players\".\"last_name\" AS \"last_name\" FROM \"players\" AS \"players\" WHERE \"players\".\"hand\" = 'L' ORDER BY \"players\".\"dob\"",
    "wta_1__abbr_v0__q0459": "SELECT \"t1\".\"cntry_code\" AS \"country_code\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"rankings\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"player_id\" ORDER BY \"t2\".\"tours\" DESC LIMIT 1",
    "wta_1__abbr_v0__q0460": "SELECT \"t1\".\"cntry_code\" AS \"country_code\", \"t1\".\"first_name\" AS \"first_name\" FROM \"players\" AS \"t1\" JOIN \"rankings\" AS \"t2\" ON \"t1\".\"player_id\" = \"t2\".\"player_id\" ORDER BY \"t2\".\"tours\" DESC LIMIT 1",
