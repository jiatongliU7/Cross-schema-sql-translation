  "q_B": {
    "museum_visit__syn_v1__q0415": "SELECT \"museum\".\"Museum_ID\" AS \"museum_id\", \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" ORDER BY \"museum\".\"staff_num\" DESC LIMIT 1",
    "museum_visit__syn_v1__q0416": "SELECT AVG(\"museum\".\"staff_num\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Open_Year\" < 2009",
    "museum_visit__syn_v1__q0417": "SELECT \"museum\".\"staff_num\" AS \"num_of_staff\", \"museum\".\"Open_Year\" AS \"open_year\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Name\" = 'Plaza Museum'",
    "museum_visit__syn_v1__q0418": "SELECT \"museum\".\"Name\" AS \"name\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"staff_num\" > (SELECT MIN(\"museum\".\"staff_num\") AS \"_col_0\" FROM \"museum\" AS \"museum\" WHERE \"museum\".\"Open_Year\" > 2010)",
    "museum_visit__syn_v1__q0423": "SELECT \"t1\".\"Name\" AS \"name\", \"t1\".\"Age\" AS \"age\" FROM \"visitor\" AS \"t1\" JOIN \"visit\" AS \"t2\" ON \"t1\".\"ID\" = \"t2\".\"visitor_ID\" ORDER BY \"t2\".\"coupon_quantity\" DESC LIMIT 1",
    "museum_visit__syn_v1__q0424": "SELECT AVG(\"visit\".\"coupon_quantity\") AS \"_col_0\", MAX(\"visit\".\"coupon_quantity\") AS \"_col_1\" FROM \"visit\" AS \"visit\""
  },
