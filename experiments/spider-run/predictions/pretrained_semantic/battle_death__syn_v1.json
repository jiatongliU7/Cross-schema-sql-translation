  "q_B": {
    "battle_death__syn_v1__q0491": "SELECT COUNT(*) AS \"_col_0\" FROM \"ship\" AS \"ship\" WHERE \"ship\".\"vessel_disposition\" = 'Captured'",
    "battle_death__syn_v1__q0505": "SELECT \"battle\".\"name\" AS \"name\", \"battle\".\"result\" AS \"result\", \"battle\".\"bulgarian_commander\" AS \"bulgarian_commander\" FROM \"battle\" AS \"battle\" EXCEPT SELECT \"t1\".\"name\" AS \"name\", \"t1\".\"result\" AS \"result\", \"t1\".\"bulgarian_commander\" AS \"bulgarian_commander\" FROM \"battle\" AS \"t1\" JOIN \"ship\" AS \"t2\" ON \"t1\".\"id\" = \"t2\".\"lost_in_battle\" WHERE \"t2\".\"site\" = 'English Channel'",
    "battle_death__syn_v1__q0506": "SELECT \"death\".\"notice\" AS \"note\" FROM \"death\" AS \"death\" WHERE \"death\".\"notice\" LIKE '%East%'"
